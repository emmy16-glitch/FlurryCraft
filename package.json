{
  "name": "flurrycraft",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Browser-native snowy voxel sandbox",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:chain": "esbuild js/sui-bridge.js --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=dist/sui-bridge.js",
    "test:move": "cd move/flurrycraft && sui move test",
    "test:chain": "node --test tests/sui-bcs.test.mjs",
    "check:sui": "node scripts/check-sui-readiness.mjs"
  },
  "dependencies": {
    "@mysten/sui": "2.39.1",
    "@mysten/dapp-kit-core": "1.6.41"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "three": "0.160.0"
  }
}
